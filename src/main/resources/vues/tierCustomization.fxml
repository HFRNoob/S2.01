<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="107.0" prefWidth="459.0" style="-fx-background-color: #434343;" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.tierCustomizationController">
   <children>
      <ColorPicker fx:id="tierColorPicker" layoutX="298.0" layoutY="44.0" style="-fx-background-color: #E3E3E3;">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></ColorPicker>
      <TextField fx:id="tierTextField" layoutX="99.0" layoutY="44.0" prefHeight="26.0" prefWidth="102.0" promptText="SSShitstorm">
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor></TextField>
      <Label layoutX="89.0" layoutY="27.0" text="Modifier le nom du tier" textFill="WHITE" />
      <Button fx:id="okButton" layoutX="212.0" layoutY="44.0" mnemonicParsing="false" onAction="#okButtonPressEvent" style="-fx-background-color: #E3E3E3; -fx-background-radius: 5;" text="Valider">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Button fx:id="downArrowButton" layoutX="14.0" layoutY="68.0" mnemonicParsing="false" onAction="#downArrowButtonPressEvent" style="-fx-background-color: transparent;" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Button fx:id="upArrowButton" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#upArrowButtonPressEvent" style="-fx-background-color: transparent;" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor></Button>
      <Label layoutX="298.0" layoutY="27.0" text="Couleur du tier" textFill="WHITE" />
      <Label fx:id="warningText" layoutX="74.0" layoutY="71.0" text="/!\ Vous ne pouvez pas mettre de nom de tier vide" textFill="RED" underline="true">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
