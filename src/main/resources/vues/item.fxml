<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.itemController">
   <children>
      <ImageView fx:id="item" fitHeight="150.0" fitWidth="200.0" onMousePressed="#selectItem" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>
