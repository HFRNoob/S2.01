<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.tierlistController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="200.0" spacing="15.0" style="-fx-padding: 15; -fx-background-color: #1f1f1f;;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="saveButton" mnemonicParsing="false" onAction="#savePressEvent" style="-fx-background-color: #E3E3E3; -fx-background-radius: 10;" text="Sauvegarder" textAlignment="CENTER">
               <font>
                  <Font size="24.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Label fx:id="tierlistName" style="-fx-text-fill: WHITE; -fx-font-size: 24;" text="TITRE DE LA TIER LIST">
               <padding>
                  <Insets left="20.0" />
               </padding></Label>
            <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="-Infinity" prefHeight="200.0" prefWidth="400.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="retourButton" onAction="#retourButtonPressEvent" style="-fx-background-color: #E3E3E3; -fx-background-radius: 10;" text="Retour à l'accueil">
               <font>
                  <Font size="24.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Button mnemonicParsing="false" style="-fx-background-color: #E3E3E3; -fx-background-radius: 10;" text="Réinitialiser">
               <font>
                  <Font size="24.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
         </children>
      </HBox>
   </top>
   <center>
      <VBox fx:id="tierlistContainer" prefHeight="200.0" prefWidth="100.0" style="-fx-padding: 10; -fx-background-color: #3a3a3a;" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
