<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="80.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.tierIndividuelController">
   <children>
      <Label fx:id="tierName" alignment="CENTER" contentDisplay="CENTER" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: RED; -fx-font-size: 20;" text="NOM DE CATEGORIE" />
      <FlowPane fx:id="tierPane" onMouseReleased="#setReleaseIndex" style="-fx-background-color: #1f1f1f;" HBox.hgrow="ALWAYS" />
      <Button fx:id="tierButton" mnemonicParsing="false" onAction="#ouvrirPagePressEvent" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #E3E3E3;" text="⚙">
         <font>
            <Font size="35.0" />
         </font>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
      </Button>
   </children>
</HBox>
